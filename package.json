{
  "name": "food-spot",
  "version": "1.0.0",
  "description": "food spot - Full-Stack MERN Food Delivery App (Your cravings. Our mission.)",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "npm --prefix backend run dev",
    "client": "npm --prefix frontend run dev",
    "seed": "npm --prefix backend run seed",
    "install-all": "npm --prefix backend install && npm --prefix frontend install",
    "build": "npm --prefix frontend run build"
  },
  "keywords": [
    "food-delivery",
    "mern-stack",
    "react",
    "express",
    "mongodb",
    "nodejs"
  ],
  "author": "food spot Team",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
